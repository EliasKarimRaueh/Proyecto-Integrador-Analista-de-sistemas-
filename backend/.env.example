PORT=3000
DATABASE_URL=postgresql://usuario:password@host:5432/base

# JWT: secretos distintos y aleatorios (mínimo 32 caracteres recomendado).
JWT_SECRET=reemplazar-con-secreto-acceso-largo-y-aleatorio
JWT_REFRESH_SECRET=reemplazar-con-secreto-refresh-largo-y-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_DIAS=1
JWT_REFRESH_DIAS_RECORDARME=7
# true sólo cuando la API se sirve por HTTPS.
COOKIE_SECURE=false

# Propietario inicial: se crea una sola vez al arrancar si no existe.
ADMIN_EMAIL=propietario@polleria.local
ADMIN_PASSWORD=reemplazar-con-contrasena-segura
ADMIN_NOMBRE=Propietario
ADMIN_APELLIDO=Sistema
