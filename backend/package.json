{
  "name": "polleria-backend",
  "version": "1.0.0",
  "description": "Backend del sistema de gestión para la pollería",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.spec.json",
    "test": "tsx --test test/operaciones.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "test:integration:sprint3": "tsx --test test/sprint3.integration.test.ts",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:jest:coverage": "jest --coverage",
    "test:all": "npm run test && npm run test:jest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "polleria-database": "file:../database",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
